{
  "name": "diy-learn",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate --config prisma.config.ts && next build",
    "start": "next start",
    "postinstall": "prisma generate --config prisma.config.ts",
    "lint": "eslint",
    "db:migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "start:railway": "pnpm db:migrate:deploy && next start"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@base-ui/react": "^1.3.0",
