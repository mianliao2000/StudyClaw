DATABASE_URL="file:./prisma/dev.db"

# Variables recognized by the current codebase
# Database: DATABASE_URL
# Auth: AUTH_SECRET, AUTH_URL, AUTH_TRUST_HOST, AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET
# OpenRouter: OPENROUTER_API_KEY, OPENROUTER_BASE_URL, OPENROUTER_MODEL_STRONG, OPENROUTER_MODEL_MEDIUM, OPENROUTER_MODEL_WEAK
# Optional OpenRouter extras: OPENROUTER_SITE_URL, OPENROUTER_APP_NAME, OPENROUTER_MODEL
# MiniMax: MINIMAX_API_KEY, MINIMAX_MODEL, MINIMAX_BASE_URL
# OpenAI: OPENAI_API_KEY, OPENAI_MODEL, OPENAI_BASE_URL
# ChatGPT bridge: CHATGPT_BRIDGE_SCRIPT, CHATGPT_MODEL, CODEX_BIN, CHATGPT_CODEX_BIN
# Anthropic-compatible: ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN, ANTHROPIC_MODEL, ANTHROPIC_REASONING_MODEL, ANTHROPIC_BASE_URL


# NextAuth
AUTH_SECRET="replace-with-a-random-secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID="replace-with-google-client-id"
AUTH_GOOGLE_SECRET="replace-with-google-client-secret"
# WeChat OAuth (optional)
# AUTH_WECHAT_APP_ID="replace-with-wechat-app-id"
# AUTH_WECHAT_APP_SECRET="replace-with-wechat-app-secret"
# AUTH_WECHAT_PLATFORM_TYPE="WebsiteApp"

# OpenRouter
# OPENROUTER_API_KEY="replace-with-openrouter-api-key"
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# OPENROUTER_MODEL_STRONG="openai/gpt-5-mini"
# OPENROUTER_MODEL_MEDIUM="stepfun/step-3.5-flash:free"
# OPENROUTER_MODEL_WEAK="nvidia/nemotron-3-super-120b-a12b:free"

# MiniMax
# MINIMAX_API_KEY="replace-with-minimax-api-key"
# MINIMAX_MODEL="MiniMax-M2.7"
# MINIMAX_BASE_URL="https://api.minimax.io/v1"

# OpenAI
# OPENAI_API_KEY="replace-with-openai-api-key"
# OPENAI_MODEL="gpt-4o"
# OPENAI_BASE_URL="https://api.openai.com/v1"

# ChatGPT OAuth bridge
# CODEX_BIN="C:/Users/your-user/.vscode/extensions/openai.chatgpt-<version>/bin/windows-x86_64/codex.exe"
# CHATGPT_BRIDGE_SCRIPT="./scripts/chatgpt-oauth-bridge.mjs"
# CHATGPT_MODEL="gpt-5.4-mini"

# Anthropic-compatible provider
# ANTHROPIC_API_KEY="replace-with-provider-key"
# ANTHROPIC_AUTH_TOKEN="replace-with-provider-token"
# ANTHROPIC_MODEL="doubao-seed-2.0-pro"
# ANTHROPIC_REASONING_MODEL="doubao-seed-2.0-pro"
# ANTHROPIC_BASE_URL="https://ark.cn-beijing.volces.com/api/coding"

# Notes
# Uncomment exactly one provider block you want to use
# If multiple provider blocks are enabled by accident, OpenRouter / MiniMax / OpenAI win before ChatGPT bridge
# OpenRouter uses OPENROUTER_MODEL_WEAK / MEDIUM / STRONG based on reasoning intensity
# ChatGPT bridge works only after: corepack pnpm chatgpt:login

# Common commands
# corepack pnpm dev:managed   -> start website in managed background mode
# corepack pnpm dev:stop      -> stop website
# corepack pnpm dev:status    -> check website status
# corepack pnpm dev:logs      -> watch dev logs in real time
# corepack pnpm build         -> build the project
# corepack pnpm chatgpt:status -> check ChatGPT OAuth status
# corepack pnpm chatgpt:login  -> run ChatGPT OAuth login
# corepack pnpm chatgpt:probe  -> verify ChatGPT OAuth with a real model call
